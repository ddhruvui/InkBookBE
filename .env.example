# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string. Keep the <db_password> placeholder as Atlas
# gives it; the real password goes in MONGO_PASSWORD.
MONGO_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_PASSWORD=

# Database inside the cluster. Locally this must NOT be InkBook (prod) — the
# server and scripts refuse to start. Defaults to InkBookTest when unset.
MONGO_DB_NAME=InkBookTest

PORT=5001

# Google Gemini (free key at aistudio.google.com). Without it the AI routes return 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ImageKit (dashboard → Developer options → API keys). Without them uploads return 503.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_id>
